NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/messenger.sqlite
ATTACHMENT_PATH=./data/uploads
JWT_ACCESS_SECRET=replace-this-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-this-with-a-different-long-random-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
BCRYPT_ROUNDS=12
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Messenger <your-address@example.com>
SMTP_TEST_TO=
